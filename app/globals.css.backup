@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================================================
   Base Styles
   ============================================================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

html, body {
  height: 100%;
  width: 100%;
}

body {
  font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  color: #1f2937;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* ============================================================================
   Smooth Transitions
   ============================================================================ */

* {
  transition-property: color;
  transition-duration: 200ms;
}

button, a, input, select, textarea {
  transition-property: all;
  transition-duration: 200ms;
}

/* ============================================================================
   Scrollbar Styling
   ============================================================================ */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.05);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, #0066cc, #00d4ff);
  border-radius: 10px;
  transition: background 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, #0052a3, #0099ff);
}

/* ============================================================================
   Focus Styles (Accessibility)
   ============================================================================ */

:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05), 0 0 0 4px #2563eb;
}

/* ============================================================================
   Selection Styling
   ============================================================================ */

::selection {
  background-color: #0066cc;
  color: white;
}

::-moz-selection {
  background-color: #0066cc;
  color: white;
}

/* ============================================================================
   Link Styling
   ============================================================================ */

a {
  color: #0066cc;
  transition: color 200ms;
}

a:hover {
  color: #0052a3;
}

a:focus-visible {
  outline: none;
  border-radius: 0.25rem;
  padding: 0 0.25rem;
  box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05), 0 0 0 4px #2563eb;
}

/* ============================================================================
   Heading Styles
   ============================================================================ */

h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  color: #1f2937;
  transition: color 200ms;
}

h1 {
  font-size: 2.25rem;
}

h2 {
  font-size: 1.875rem;
}

h3 {
  font-size: 1.5rem;
}

h4 {
  font-size: 1.25rem;
}

h5, h6 {
  font-size: 1.125rem;
}

/* ============================================================================
   Form Elements
   ============================================================================ */

input, textarea, select {
  appearance: none;
}

/* Remove default input styles */
input[type='text'],
input[type='email'],
input[type='password'],
input[type='number'],
textarea,
select {
  outline: none;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05), 0 0 0 3px rgba(37, 99, 235, 0.1);
  border-color: transparent;
  transition: all 200ms;
}

/* ============================================================================
   Code Block Styling
   ============================================================================ */

code {
  background-color: #f3f4f6;
  padding: 0.5rem 0.5rem;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-family: 'Courier New', monospace;
  color: #1f2937;
}

pre {
  background-color: #111827;
  color: #f3f4f6;
  padding: 1rem;
  border-radius: 0.5rem;
  overflow-x: auto;
}

pre code {
  background-color: transparent;
  padding: 0;
}

/* ============================================================================
   Container Sizing
   ============================================================================ */

.container {
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
}

/* ============================================================================
   Glassmorphism Effects
   ============================================================================ */

.glass {
  backdrop-filter: blur(12px);
  background-color: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.glass-sm {
  backdrop-filter: blur(4px);
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.glass-md {
  backdrop-filter: blur(12px);
  background-color: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.glass-lg {
  backdrop-filter: blur(16px);
  background-color: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.glass-dark {
  backdrop-filter: blur(12px);
  background-color: rgba(30, 41, 59, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.glass-dark-sm {
  backdrop-filter: blur(4px);
  background-color: rgba(30, 41, 59, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

/* ============================================================================
   Gradient Utilities
   ============================================================================ */

.gradient-primary {
  background: linear-gradient(to right, #0066cc, #003d99);
}

.gradient-accent {
  background: linear-gradient(to right, #00d4ff, #0099ff);
}

.gradient-success {
  background: linear-gradient(to right, #22c55e, #16a34a);
}

.gradient-warning {
  background: linear-gradient(to right, #f59e0b, #b45309);
}

.gradient-danger {
  background: linear-gradient(to right, #ef4444, #991b1b);
}

.gradient-text-primary {
  background: linear-gradient(to right, #0066cc, #00d4ff);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.gradient-text-accent {
  background: linear-gradient(to right, #00d4ff, #0099ff);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ============================================================================
   Premium Shadows
   ============================================================================ */

.shadow-glow {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 0 20px rgba(0, 102, 204, 0.3);
}

.shadow-glow-lg {
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 0 40px rgba(0, 102, 204, 0.4);
}

.shadow-glow-accent {
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
}

.shadow-glass {
  box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
}

.shadow-glass-sm {
  box-shadow: 0 4px 16px 0 rgba(31, 38, 135, 0.25);
}

.shadow-glass-lg {
  box-shadow: 0 15px 35px 0 rgba(31, 38, 135, 0.4);
}

/* ============================================================================
   Premium Hover Effects
   ============================================================================ */

.hover-lift {
  transition: all 250ms;
}

.hover-lift:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.hover-lift-sm {
  transition: all 250ms;
}

.hover-lift-sm:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.hover-lift-lg {
  transition: all 250ms;
}

.hover-lift-lg:hover {
  transform: translateY(-8px);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

.hover-glow {
  transition: all 250ms;
}

.hover-glow:hover {
  box-shadow: 0 0 20px rgba(0, 102, 204, 0.3);
}

.hover-scale {
  transition: transform 250ms;
}

.hover-scale:hover {
  transform: scale(1.05);
}

.hover-scale-sm {
  transition: transform 250ms;
}

.hover-scale-sm:hover {
  transform: scale(1.02);
}

/* ============================================================================
   Premium Button Styles
   ============================================================================ */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  font-weight: 500;
  transition: all 250ms;
  outline: none;
  border: none;
  cursor: pointer;
  disabled: opacity 50%;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05), 0 0 0 4px #2563eb;
}

.btn-primary {
  background: linear-gradient(to right, #0066cc, #003d99);
  color: white;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  transition: all 250ms;
}

.btn-primary:hover:not(:disabled) {
  box-shadow: 0 0 20px rgba(0, 102, 204, 0.3);
  transform: translateY(-2px);
}

.btn-secondary {
  background-color: rgba(255, 255, 255, 0.1);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
  transition: all 250ms;
}

.btn-secondary:hover:not(:disabled) {
  background-color: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.btn-ghost {
  color: #0066cc;
  transition: background 200ms;
}

.btn-ghost:hover {
  background-color: #f0f7ff;
}

.btn-danger {
  background: linear-gradient(to right, #ef4444, #991b1b);
  color: white;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  transition: all 250ms;
}

.btn-danger:hover:not(:disabled) {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  transform: translateY(-2px);
}

.btn-success {
  background: linear-gradient(to right, #22c55e, #16a34a);
  color: white;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  transition: all 250ms;
}

.btn-success:hover:not(:disabled) {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  transform: translateY(-2px);
}

.btn-warning {
  background: linear-gradient(to right, #f59e0b, #b45309);
  color: white;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  transition: all 250ms;
}

.btn-warning:hover:not(:disabled) {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  transform: translateY(-2px);
}

.btn-sm {
  padding: 0.375rem 0.75rem;
  font-size: 0.875rem;
}

.btn-lg {
  padding: 0.75rem 1.5rem;
  font-size: 1.125rem;
}

.btn-xl {
  padding: 1rem 2rem;
  font-size: 1.25rem;
}

/* ============================================================================
   Premium Card Styles
   ============================================================================ */

.card {
  background-color: white;
  border-radius: 0.75rem;
  border: 1px solid #e5e7eb;
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
  transition: all 300ms;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.card-glass {
  backdrop-filter: blur(12px);
  background-color: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 0.75rem;
  box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
}

.card-glass-dark {
  backdrop-filter: blur(12px);
  background-color: rgba(30, 41, 59, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 0.75rem;
  box-shadow: 0 15px 35px 0 rgba(31, 38, 135, 0.4);
}

.card-compact {
  padding: 1rem;
}

.card-sm {
  padding: 1.25rem;
}

.card-md {
  padding: 1.5rem;
}

.card-lg {
  padding: 2rem;
}

.card-xl {
  padding: 2.5rem;
}

.card-header {
  padding-bottom: 1rem;
  border-bottom: 1px solid #e5e7eb;
}

.card-body {
  padding-top: 1rem;
  padding-bottom: 1rem;
}

.card-footer {
  padding-top: 1rem;
  border-top: 1px solid #e5e7eb;
}

/* Gradient card accent */
.card-accent {
  position: relative;
  overflow: hidden;
}

.card-accent::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(to right, #0066cc, #00d4ff);
}

/* ============================================================================
   Premium Input & Form Styles
   ============================================================================ */

.input {
  width: 100%;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  border: 1px solid #d1d5db;
  background-color: rgba(255, 255, 255, 0.8);
  color: #1f2937;
  transition: all 250ms;
}

.input:focus {
  outline: none;
  border-color: #0066cc;
  box-shadow: inset 0 0 0 1px rgba(0, 102, 204, 0.1), 0 0 0 3px rgba(0, 102, 204, 0.1);
}

.input:disabled {
  background-color: #f3f4f6;
  opacity: 0.5;
  cursor: not-allowed;
}

.input-glass {
  backdrop-filter: blur(12px);
  background-color: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  color: white;
}

.input-glass::placeholder {
  color: #d1d5db;
}

.input-glass:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgba(0, 102, 204, 0.3);
}

.input-lg {
  padding: 0.75rem 1.25rem;
  font-size: 1.125rem;
}

.input-error {
  border-color: #ef4444;
}

.input-error:focus {
  border-color: #ef4444;
  box-shadow: inset 0 0 0 1px rgba(239, 68, 68, 0.1), 0 0 0 3px rgba(239, 68, 68, 0.1);
}

.input-success {
  border-color: #22c55e;
}

.input-success:focus {
  border-color: #22c55e;
  box-shadow: inset 0 0 0 1px rgba(34, 197, 94, 0.1), 0 0 0 3px rgba(34, 197, 94, 0.1);
}

.label {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
  color: #374151;
  margin-bottom: 0.5rem;
}

.label-error {
  color: #dc2626;
}

/* ============================================================================
   Premium Typography
   ============================================================================ */

.text-gradient-primary {
  background: linear-gradient(to right, #0066cc, #00d4ff);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 700;
}

.text-gradient-accent {
  background: linear-gradient(to right, #00d4ff, #0099ff);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 700;
}

.heading-1 {
  font-size: 2.25rem;
  font-weight: 700;
  color: #1f2937;
}

.heading-2 {
  font-size: 1.875rem;
  font-weight: 700;
  color: #1f2937;
}

.heading-3 {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1f2937;
}

.heading-4 {
  font-size: 1.25rem;
  font-weight: 600;
  color: #1f2937;
}

.subheading {
  font-size: 1.125rem;
  font-weight: 600;
  color: #4b5563;
}

.caption {
  font-size: 0.75rem;
  font-weight: 500;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ============================================================================
   Premium Badge Styles
   ============================================================================ */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  transition: all 250ms;
}

.badge-primary {
  background-color: #f0f7ff;
  color: #003d99;
}

.badge-success {
  background-color: #dcfce7;
  color: #15803d;
}

.badge-warning {
  background-color: #fef3c7;
  color: #b45309;
}

.badge-danger {
  background-color: #fee2e2;
  color: #991b1b;
}

.badge-info {
  background-color: #dbeafe;
  color: #1e40af;
}

.badge-glass {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(4px);
}

/* ============================================================================
   Premium Divider Styles
   ============================================================================ */

.divider {
  margin-top: 1rem;
  margin-bottom: 1rem;
  border-top: 1px solid #e5e7eb;
}

.divider-light {
  border-color: #f3f4f6;
}

.divider-dark {
  border-color: #d1d5db;
}

/* ============================================================================
   Premium Utility Classes
   ============================================================================ */

.text-truncate-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.backdrop-blur-xl {
  backdrop-filter: blur(24px);
}

/* Smooth transitions by default */
.smooth-transition {
  transition: all 250ms;
}

/* Glassmorphism overlay */
.overlay-glass {
  position: fixed;
  inset: 0;
  backdrop-filter: blur(4px);
  background-color: rgba(0, 0, 0, 0.2);
}

/* Loading shimmer effect */
.shimmer {
  animation: shimmer 2s infinite;
  background: linear-gradient(to right, #d1d5db, #e5e7eb, #d1d5db);
  background-size: 1000px 100%;
}

/* Animated gradient background */
.bg-animate {
  background: linear-gradient(
    -45deg,
    #0066cc,
    #00d4ff,
    #22c55e,
    #0066cc
  );
  background-size: 400% 400%;
  animation: gradientShift 15s ease infinite;
}

@keyframes gradientShift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* ============================================================================
   Entrance Animations
   ============================================================================ */

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInUp {
  from {
    transform: translateY(30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideInDown {
  from {
    transform: translateY(-30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideInLeft {
  from {
    transform: translateX(-30px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes slideInRight {
  from {
    transform: translateX(30px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes float-slow {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-15px);
  }
}

@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 20px rgba(0, 102, 204, 0.3);
  }
  50% {
    box-shadow: 0 0 40px rgba(0, 102, 204, 0.5);
  }
}

@keyframes shimmer {
  0% {
    background-position: -1000px 0;
  }
  100% {
    background-position: 1000px 0;
  }
}

/* ============================================================================
   Responsive Typography
   ============================================================================ */

@media (max-width: 640px) {
  h1 {
    font-size: 1.875rem;
  }
  
  h2 {
    font-size: 1.5rem;
  }
  
  h3 {
    font-size: 1.25rem;
  }
}

/* ============================================================================
   Dark Mode Support
   ============================================================================ */

@media (prefers-color-scheme: dark) {
  body {
    background: #0f172a;
    color: #e5e7eb;
  }

  a {
    color: #4dd0e1;
  }

  a:hover {
    color: #26c6da;
  }

  h1, h2, h3, h4, h5, h6 {
    color: #f3f4f6;
  }

  code {
    background-color: #1f2937;
    color: #f3f4f6;
  }

  ::-webkit-scrollbar-track {
    background: #1f2937;
  }
}

/* ============================================================================
   Reduced Motion Support
   ============================================================================ */

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    animation: none !important;
  }

  html {
    scroll-behavior: auto;
  }
}


/* ============================================================================
   Content Layout Utilities - Consistent Width Constraints
   ============================================================================ */

/* Main content wrapper - already applied in dashboard layout */
.content-wrapper {
  max-width: 112rem; /* 1792px - for dashboard/tables */
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
}

@media (min-width: 640px) {
  .content-wrapper {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .content-wrapper {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}

/* Form container - compact centered forms */
.form-container {
  max-width: 56rem; /* 896px - for standard forms */
  margin-left: auto;
  margin-right: auto;
}

/* Narrow form container - for simple forms (login, reset password, etc) */
.form-container-narrow {
  max-width: 32rem; /* 512px */
  margin-left: auto;
  margin-right: auto;
}

/* Wide form container - for complex multi-column forms */
.form-container-wide {
  max-width: 72rem; /* 1152px */
  margin-left: auto;
  margin-right: auto;
}

/* Card container - for content cards */
.card-container {
  max-width: 64rem; /* 1024px */
  margin-left: auto;
  margin-right: auto;
}

/* Full width container - for tables and dashboards */
.full-width-container {
  width: 100%;
}

/* Form card - consistent styling for form wrappers */
.form-card {
  background-color: white;
  border-radius: 0.75rem;
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  padding: 1.5rem;
}

@media (min-width: 768px) {
  .form-card {
    padding: 2rem;
  }
}
