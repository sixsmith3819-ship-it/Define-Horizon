# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
# The public URL of your application (used for redirects, callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Database URL (can be derived from Supabase URL if needed)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Environment
# Set to 'development', 'staging', or 'production'
NODE_ENV=development

# Authentication Timeout (in minutes)
# Session will automatically expire after this period of inactivity
AUTH_TIMEOUT_MINUTES=30

# Service Charge Rates (percentages, 0-100)
# Default international transaction service charge
DEFAULT_INTERNATIONAL_SERVICE_CHARGE_RATE=10
# Default local transaction service charge
DEFAULT_LOCAL_SERVICE_CHARGE_RATE=8

# Email Configuration (for announcements, notifications, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@definehorizon.com

# Logging
# Set to 'true' to enable debug logging
DEBUG_LOGGING=false

# Optional: Analytics/Monitoring
# SENTRY_DSN=your-sentry-dsn
